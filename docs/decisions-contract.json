    "CaseStatus": ["Draft", "InProgress", "ChangesRequired", "OnHold", "Rejected", "Cancelled", "Failed", "Completed"],
    "ApprovalStatus": ["Pending", "Approved", "ChangesRequested", "Rejected", "Skipped"],
    "DocumentStatus": ["NotStarted", "Generating", "AwaitingUpload", "InReview", "Complete", "Rejected"],
    "SignatureStatus": ["NotSent", "Sent", "Viewed", "Signed", "Declined", "Expired"],
    "TaskStatus": ["NotStarted", "InProgress", "Blocked", "Complete", "Cancelled"],
    "CheckStatus": ["NotStarted", "InProgress", "Passed", "Failed", "Waived"],
    "ExceptionType": ["ChangesRequired", "Rejected", "Cancelled", "OnHold", "Overdue", "Failure"],
    "EmploymentType": ["FullTime", "PartTime", "Contract", "Intern"],
    "NotificationChannel": ["Email", "InApp", "SMS"],
    "SlaState": ["OnTrack", "DueSoon", "Overdue", "NotApplicable"],
    "AppRole": ["HRSpecialist", "HRManager", "Approver", "TaskAssignee", "Signer", "Auditor"]
